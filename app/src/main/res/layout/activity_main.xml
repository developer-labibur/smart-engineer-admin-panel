<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".view.MainActivity">

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="@dimen/_170dp"
        android:layout_height="@dimen/_260dp"
        android:contentDescription="@string/smart_engineer_logo"
        android:src="@drawable/logo_red_transparent_with_se_admin_panel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.30" />



    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/googleCntBtn"
        style="@style/btn_social_media"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:drawableStart="@drawable/sl_google_color"
        android:text="@string/continue_with_google"
        android:textColor="@color/black"
        android:textSize="@dimen/text_size_medium"
        android:layout_marginTop="70dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgLogo" />


</androidx.constraintlayout.widget.ConstraintLayout>