<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.BookDetailsActivity"
    android:padding="16dp">

    <!-- Book Cover Image -->
    <ImageView
        android:id="@+id/bookCoverImage"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:contentDescription="@string/book_cover"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/bookTitle"
        android:layout_marginEnd="16dp"
        android:src="@drawable/forgot_password_amico_1_" />

    <!-- Book Title -->
    <TextView
        android:id="@+id/bookTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Book Title"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/bookCoverImage"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Book Code -->
    <TextView
        android:id="@+id/bookCodes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Book Code: "
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/bookTitle"
        app:layout_constraintStart_toEndOf="@+id/bookCoverImage"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Total Units -->
    <TextView
        android:id="@+id/bookTotalUnits"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Total Units:"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/bookCodes"
        app:layout_constraintStart_toEndOf="@+id/bookCoverImage"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Other UI elements -->

    <TextView
        android:id="@+id/textViewXDep"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="Departments: "
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@+id/bookTotalUnits"
        app:layout_constraintTop_toBottomOf="@+id/bookTotalUnits" />

    <TextView
        android:id="@+id/textViewXSem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="Semesters: "
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@+id/bookCoverImage"
        app:layout_constraintTop_toBottomOf="@+id/textViewXDep" />

    <!-- Other UI elements -->
    <TextView
        android:id="@+id/viewCountTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Views: 0"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@+id/textViewXSem"
        app:layout_constraintTop_toBottomOf="@+id/textViewXSem" />

    <!-- RecyclerView for Units -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/unitRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewCountTextView"
        tools:listitem="@layout/item_book_unit" />

</androidx.constraintlayout.widget.ConstraintLayout>